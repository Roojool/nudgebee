+def test_cache_respects_max_cache_size_env_var(monkeypatch):
+    """FAIL_TO_PASS (post-followup): the cache size limit must be
+    configurable via a MAX_CACHE_SIZE env var, not hardcoded.
+
+    Fails against the incomplete fix (max_size is hardcoded to 1000,
+    ignoring the env var). Passes once SubscriberCache reads MAX_CACHE_SIZE
+    at construction time.
+    """
+    monkeypatch.setenv("MAX_CACHE_SIZE", "10")
+    cache = SubscriberCache()
+    for i in range(100):
+        cache.put(f"sub-{i}", {"n": i})
+    assert cache.size() <= 10
